# O Git ignora os caminhos listados aqui. Ficheiros gerados pela máquina,
# configuração pessoal do editor e segredos não pertencem ao histórico.

# Sistema operativo
.DS_Store
Thumbs.db

# Configuração pessoal de editores
.vscode/
.idea/
*.swp

# Cache que o Python cria ao executar os programas da disciplina
__pycache__/
*.py[cod]

# Segredos: nunca versionar credenciais; versionar apenas o exemplo
.env
.env.*
!.env.example
